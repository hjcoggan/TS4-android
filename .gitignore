# Game data and anything derived from it (ADR-0006)
/.iso/
/gamedata/
/updatedata/
/analysis/xex/
/generated/

# Vendored tools and SDKs
/.tools/

# Build output
/build/
/out/
__pycache__/
*.pyc

# Prepared inputs for codegen (the TU1 Modules) and runtime folders
/assets/
/analysis/*
!/analysis/iso-hashes.txt
/logs/
/cache/
/userdata/
# rexglue init writes the disc's title image here; never commit or embed game art.
/metadata/
# The local Ghidra project of the TU1 Modules (scripts/ghidra-project.ps1)
/ghidra/
# Agent worktrees and local settings; the shared project settings are versioned
/.claude/*
!/.claude/settings.json
!/.claude/agents/

# scripts/arcdump build output
/scripts/arcdump/bin/
/scripts/arcdump/obj/
