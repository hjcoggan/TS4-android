{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "host-debug",
            "displayName": "Host Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "android-arm64-debug",
            "displayName": "Android arm64 Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ANDROID_ABI": "arm64-v8a",
                "ANDROID_PLATFORM": "android-29",
                "ANDROID_STL": "c++_shared"
            }
        },
        {
            "name": "android-arm64-release",
            "displayName": "Android arm64 Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ANDROID_ABI": "arm64-v8a",
                "ANDROID_PLATFORM": "android-29",
                "ANDROID_STL": "c++_shared"
            }
        },
        {
            "name": "android-arm64-rex-debug",
            "displayName": "Android arm64 Debug + ReXGlue SDK",
            "description": "The real app: libtopspin4.so linked against work/rexglue-sdk. Builds the SDK as a subdirectory, so the first configure+build is long. Set REXSDK_DIR on the command line to use another working copy.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/../work/build/ts4-android-rex-debug",
            "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ANDROID_ABI": "arm64-v8a",
                "ANDROID_PLATFORM": "android-29",
                "ANDROID_STL": "c++_shared",
                "TS4_WITH_REXGLUE": "ON",
                "REXSDK_DIR": "${sourceDir}/../work/rexglue-sdk"
            }
        },
        {
            "name": "android-arm64-rex-release",
            "displayName": "Android arm64 Release + ReXGlue SDK",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/../work/build/ts4-android-rex-release",
            "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ANDROID_ABI": "arm64-v8a",
                "ANDROID_PLATFORM": "android-29",
                "ANDROID_STL": "c++_shared",
                "TS4_WITH_REXGLUE": "ON",
                "REXSDK_DIR": "${sourceDir}/../work/rexglue-sdk"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "host-debug",
            "configurePreset": "host-debug"
        },
        {
            "name": "android-arm64-debug",
            "configurePreset": "android-arm64-debug"
        },
        {
            "name": "android-arm64-release",
            "configurePreset": "android-arm64-release"
        },
        {
            "name": "android-arm64-rex-debug",
            "configurePreset": "android-arm64-rex-debug"
        },
        {
            "name": "android-arm64-rex-release",
            "configurePreset": "android-arm64-rex-release"
        }
    ]
}
