# D3D hooks for each Module's copy of Direct3D (src/d3d/hooks.h, src/d3d/sink.h), generated at
# configure time from symbols/d3d-functions.csv (module,address,name,role,evidence):
#   <build>/d3d/d3d_functions.h     TS4_D3D_FUNCTIONS(X): every name, in table order
#   <build>/d3d/hooks_<module>.cpp  one TS4_D3D_HOOK (role renderer) or TS4_D3D_COUNT (census)
#                                   line per row, built into that Module's DLL
# The output is rewritten only when it changes, so editing the table rebuilds only the hooks.
# A sweep build (-DTOPSPIN4_D3D_SWEEP=ON, a developer tool) also reads analysis/d3d-sweep.csv
# (scripts/gen_d3d_sweep.py): a counted hook on every other function of a D3D copy.

option(TOPSPIN4_D3D_SWEEP "Count every function of a D3D copy (analysis/d3d-sweep.csv)" OFF)
set(TOPSPIN4_D3D_TABLES "${CMAKE_CURRENT_SOURCE_DIR}/symbols/d3d-functions.csv")
if(TOPSPIN4_D3D_SWEEP)
    list(APPEND TOPSPIN4_D3D_TABLES "${CMAKE_CURRENT_SOURCE_DIR}/analysis/d3d-sweep.csv")
endif()
set(TOPSPIN4_D3D_GENERATED "${CMAKE_CURRENT_BINARY_DIR}/d3d")

set(_d3d_rows "")
foreach(_d3d_table IN LISTS TOPSPIN4_D3D_TABLES)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_d3d_table}")
    # Read whole: a CMake list splits on ';', which the evidence column uses.
    file(READ "${_d3d_table}" _d3d_text)
    string(REPLACE ";" "," _d3d_text "${_d3d_text}")
    string(REPLACE "\r" "" _d3d_text "${_d3d_text}")
    string(REPLACE "\n" ";" _d3d_table_rows "${_d3d_text}")
    list(POP_FRONT _d3d_table_rows)  # header
    list(APPEND _d3d_rows ${_d3d_table_rows})
endforeach()
set(_d3d_names "")
set(_d3d_lines_Loader_DLL "")
set(_d3d_lines_Swing_DLL "")
foreach(_d3d_row IN LISTS _d3d_rows)
    if(_d3d_row STREQUAL "")
        continue()
    endif()
    string(REPLACE "," ";" _d3d_fields "${_d3d_row}")
    list(GET _d3d_fields 0 _d3d_module)
    list(GET _d3d_fields 1 _d3d_address)
    list(GET _d3d_fields 2 _d3d_name)
    list(GET _d3d_fields 3 _d3d_role)
    string(REPLACE ".xex" "" _d3d_module "${_d3d_module}")
    string(TOUPPER "${_d3d_address}" _d3d_address)
    if(NOT _d3d_module MATCHES "^(Loader_DLL|Swing_DLL)$" OR NOT _d3d_address MATCHES "^8[0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F]$")
        message(FATAL_ERROR "d3d-functions.csv: bad row: ${_d3d_row}")
    endif()
    if(_d3d_role STREQUAL "renderer")
        set(_d3d_macro TS4_D3D_HOOK)
    elseif(_d3d_role STREQUAL "census")
        set(_d3d_macro TS4_D3D_COUNT)
    else()
        message(FATAL_ERROR "d3d-functions.csv: role must be renderer or census: ${_d3d_row}")
    endif()
    if(NOT _d3d_name IN_LIST _d3d_names)
        list(APPEND _d3d_names "${_d3d_name}")
    endif()
    string(APPEND _d3d_lines_${_d3d_module} "${_d3d_macro}(${_d3d_name}, ${_d3d_address})\n")
endforeach()

set(_d3d_x "")
foreach(_d3d_name IN LISTS _d3d_names)
    string(APPEND _d3d_x " \\\n  X(${_d3d_name})")
endforeach()
file(CONFIGURE OUTPUT "${TOPSPIN4_D3D_GENERATED}/d3d_functions.h" CONTENT
"// Generated by cmake/d3d_hooks.cmake from symbols/d3d-functions.csv. Do not edit.
#pragma once
#define TS4_D3D_FUNCTIONS(X)${_d3d_x}
" @ONLY)

foreach(_d3d_module Loader_DLL Swing_DLL)
    string(REPLACE "_DLL" "" _d3d_enum "${_d3d_module}")
    set(_d3d_lines "${_d3d_lines_${_d3d_module}}")
    file(CONFIGURE OUTPUT "${TOPSPIN4_D3D_GENERATED}/hooks_${_d3d_module}.cpp" CONTENT
"// Generated by cmake/d3d_hooks.cmake from symbols/d3d-functions.csv. Do not edit.
#define TS4_D3D_MODULE ::topspin4::d3d::Module::k${_d3d_enum}
#include \"d3d/hooks.h\"

${_d3d_lines}" @ONLY)
endforeach()

# The sink both sides link (src/d3d/sink.h); it sits next to the exe, as the Module DLLs do.
# It also carries the OPTIONS row's sink (src/settings/options_row_sink.h).
add_library(topspin4_d3d_sink SHARED src/d3d/sink.cpp src/settings/options_row_sink.cpp)
target_compile_definitions(topspin4_d3d_sink PRIVATE TOPSPIN4_D3D_SINK_BUILD)
target_include_directories(topspin4_d3d_sink PUBLIC
    "${CMAKE_CURRENT_SOURCE_DIR}/src" "${TOPSPIN4_D3D_GENERATED}")

foreach(_d3d_module Loader_DLL Swing_DLL)
    if(TARGET topspin4_${_d3d_module})
        target_sources(topspin4_${_d3d_module} PRIVATE
            "${TOPSPIN4_D3D_GENERATED}/hooks_${_d3d_module}.cpp")
        target_link_libraries(topspin4_${_d3d_module} PRIVATE topspin4_d3d_sink)
    endif()
endforeach()

# The OPTIONS row's hooks (ticket 11) override three Swing functions.
if(TARGET topspin4_Swing_DLL)
    target_sources(topspin4_Swing_DLL PRIVATE src/settings/options_row_hooks.cpp)
endif()
