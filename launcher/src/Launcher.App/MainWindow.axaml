<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TopSpin4.Launcher.MainWindow"
        Title="Top Spin 4 Recomp"
        Width="1280" Height="720" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BaseBrush}">
  <Grid>
    <!-- The backdrop, back to front: the original look's own gradient (MainWindow.ShowPageLook), the player's art when the
         art folder has it, then the scrim that keeps text off the picture: a left-to-right fade on Home, a flat one elsewhere. -->
    <Border x:Name="OriginalBackdrop" IsHitTestVisible="False" />
    <Image x:Name="BackgroundImage" Stretch="UniformToFill" IsVisible="False" IsHitTestVisible="False" />
    <Border x:Name="SideScrim" IsHitTestVisible="False" />
    <Border x:Name="BottomScrim" IsHitTestVisible="False" />

    <Grid ColumnDefinitions="Auto,*">
      <!-- The side rail: the game's icon, then the pages. Filled by the code behind (MainWindow.BuildRail). -->
      <Border x:Name="Rail" Grid.Column="0" Width="116" Background="{StaticResource ScrimBrush}">
        <DockPanel>
          <Panel DockPanel.Dock="Top" Height="96" Margin="0,16,0,8">
            <Image x:Name="RailIcon" Width="56" Height="56" Stretch="Uniform" IsVisible="False" />
            <StackPanel x:Name="RailWordmark" VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock Classes="display" Text="TS4" FontSize="38" HorizontalAlignment="Center"
                         Foreground="{StaticResource AccentTextBrush}" />
            </StackPanel>
          </Panel>
          <StackPanel x:Name="NavHost" Spacing="4" />
        </DockPanel>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="*,Auto">
        <!-- Home fills the area itself; Setup, Settings and Achievements sit in one scrolling column on the scrim. -->
        <Panel x:Name="PageHost" Grid.Row="0">
          <ScrollViewer x:Name="FormScroller" HorizontalScrollBarVisibility="Disabled">
            <Border x:Name="ContentScrim" Background="{StaticResource ScrimBrush}" CornerRadius="8" Padding="28,24"
                    MaxWidth="980" Margin="32,28" HorizontalAlignment="Left" VerticalAlignment="Top">
              <StackPanel Spacing="18">
                <!-- The title: the logo from the player's disc when there is one, else the title text. -->
                <StackPanel x:Name="TitleText" Orientation="Horizontal" Spacing="14">
                  <TextBlock Classes="display" Text="TOP SPIN 4" FontSize="44" LetterSpacing="2"
                             Foreground="{StaticResource AccentTextBrush}" />
                  <TextBlock Classes="kicker" Text="RECOMP" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel x:Name="LogoBlock" Orientation="Horizontal" Spacing="14" IsVisible="False">
                  <Image x:Name="LogoImage" Stretch="Uniform" Height="52" />
                  <TextBlock Classes="kicker" Text="RECOMP" VerticalAlignment="Center" />
                </StackPanel>
                <Panel x:Name="FormHost" />
              </StackPanel>
            </Border>
          </ScrollViewer>
        </Panel>

        <Border Grid.Row="1" x:Name="Footer" Padding="24,8,24,10" Background="{StaticResource ScrimBrush}">
          <StackPanel Spacing="2">
            <TextBlock x:Name="HintText" Classes="small" Foreground="{StaticResource TextBrush}" />
            <TextBlock x:Name="FooterText" Classes="small" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="CreditText" Classes="small" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
