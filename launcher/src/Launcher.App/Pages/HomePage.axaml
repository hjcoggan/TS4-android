<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TopSpin4.Launcher.Pages.HomePage">
  <!-- After setup: PLAY with a status line, the labelled actions, and Safe start under "Trouble starting?". Drawn from HomeModel. -->
  <StackPanel Spacing="18">
    <StackPanel.Styles>
      <Style Selector="Button.attention">
        <Setter Property="Background" Value="{StaticResource SecondaryBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="28,8" />
      </Style>
      <Style Selector="Button.attention:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SilverBrush}" />
        <Setter Property="Foreground" Value="{StaticResource BaseBrush}" />
      </Style>
    </StackPanel.Styles>
    <!-- The box art sits beside PLAY when the player's art folder has it; without it the column is empty and PLAY stays centred. -->
    <Grid ColumnDefinitions="Auto,*">
      <Border x:Name="BoxArtFrame" Grid.Column="0" IsVisible="False" Width="280" CornerRadius="4" ClipToBounds="True"
              VerticalAlignment="Center" Margin="0,0,24,0">
        <Image x:Name="BoxArtImage" Stretch="Uniform" />
      </Border>
      <StackPanel Grid.Column="1" Spacing="18" VerticalAlignment="Center">
        <Button x:Name="PlayButton" Classes="play" Content="PLAY" />
        <TextBlock x:Name="StatusText" Classes="body" TextAlignment="Left" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </Grid>
    <TextBlock x:Name="NoteText" Classes="error" TextAlignment="Left" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
    <!-- Safe start moves here after a GPU failure or a crash. -->
    <StackPanel x:Name="ProminentHost" HorizontalAlignment="Center" />

    <StackPanel x:Name="ActionsHost" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" />

    <!-- "Game files are in … [Change…]": added by the code behind of the window (GameFilesLocationPanel). -->
    <StackPanel x:Name="LocationHost" />

    <Border Background="{StaticResource PanelBrush}" CornerRadius="4" Padding="18" Margin="0,16,0,0">
      <StackPanel Spacing="8">
        <TextBlock x:Name="TroubleHeading" FontSize="20" FontWeight="Bold" Foreground="White" />
        <TextBlock Classes="small" TextAlignment="Left"
                   Text="If the game won't start: runs once with the default settings and leaves your Settings file unchanged." />
        <StackPanel x:Name="TroubleHost" Orientation="Horizontal" Spacing="12" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
