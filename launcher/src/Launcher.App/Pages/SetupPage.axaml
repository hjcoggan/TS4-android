<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TopSpin4.Launcher.Pages.SetupPage">
  <!-- First run: prepare the disc and Title Update 1. Drawn from SetupFlow. -->
  <StackPanel Spacing="14">
    <TextBlock Classes="body" TextAlignment="Center"
               Text="To play, you need a disc image (.iso) of your own Top Spin 4 Xbox 360 disc and its Title Update 1. Setup checks both and copies the game files once. It never changes your disc image or update file." />

    <Border x:Name="DiscPanel" Background="{StaticResource PanelBrush}" CornerRadius="4" Padding="18">
      <StackPanel Spacing="8">
        <TextBlock FontSize="22" FontWeight="Bold" Foreground="White" Text="Disc image" />
        <TextBlock x:Name="DiscPathText" Classes="small" Text="No disc image chosen" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button x:Name="ChooseDiscButton" Classes="secondary" Content="Choose disc image…" />
          <Button x:Name="NextDiscButton" Classes="secondary" Content="Next one found" IsVisible="False" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border x:Name="TitleUpdatePanel" Background="{StaticResource PanelBrush}" CornerRadius="4" Padding="18">
      <StackPanel Spacing="8">
        <TextBlock FontSize="22" FontWeight="Bold" Foreground="White" Text="Title Update 1" />
        <TextBlock x:Name="TitleUpdatePathText" Classes="small" Text="No Title Update 1 chosen" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button x:Name="ChooseTitleUpdateButton" Classes="secondary" Content="Choose Title Update 1…" />
          <Button x:Name="NextTitleUpdateButton" Classes="secondary" Content="Next one found" IsVisible="False" />
        </StackPanel>
      </StackPanel>
    </Border>

    <TextBlock x:Name="SetupMessage" Classes="error" TextAlignment="Center" IsVisible="False" />

    <StackPanel x:Name="ProgressPanel" Spacing="8" IsVisible="False">
      <ProgressBar x:Name="SetupProgressBar" Minimum="0" Maximum="1" Height="14" />
      <TextBlock x:Name="SetupProgressText" Classes="body" TextAlignment="Center" />
      <Button x:Name="CancelButton" Classes="secondary" Content="Stop" HorizontalAlignment="Center" />
    </StackPanel>

    <Button x:Name="PrepareButton" Classes="play" Content="SET UP" IsEnabled="False" />
  </StackPanel>
</UserControl>
