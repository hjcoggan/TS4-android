<!--
  The Launcher's look: bold condensed display type (Anton) and condensed body type (Barlow
  Condensed), both bundled under the SIL Open Font License; ball yellow and court blue on a dark
  base. No game art. Every button shows a thick focus outline, because the Launcher is
  driven by a pad as much as by a mouse.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <FontFamily x:Key="DisplayFont">avares://topspin4-launcher/Assets/Fonts#Anton</FontFamily>
    <FontFamily x:Key="BodyFont">avares://topspin4-launcher/Assets/Fonts#Barlow Condensed</FontFamily>

    <Color x:Key="Navy">#0A1220</Color>
    <SolidColorBrush x:Key="BaseBrush" Color="#0A1220" />
    <SolidColorBrush x:Key="PanelBrush" Color="#142038" />
    <SolidColorBrush x:Key="BallBrush" Color="#D7E44A" />
    <SolidColorBrush x:Key="BallHotBrush" Color="#EAF56E" />
    <SolidColorBrush x:Key="CourtBrush" Color="#2A6FDB" />
    <SolidColorBrush x:Key="SkyBrush" Color="#8CB4FF" />
    <SolidColorBrush x:Key="TextBrush" Color="#E6ECFF" />
    <SolidColorBrush x:Key="MutedBrush" Color="#9AA8D0" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF8A7A" />
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <Style Selector="TextBlock.display">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <!-- Text sizes: the condensed face runs small, so even the smallest text is 18. Paragraphs are left-aligned. -->
  <Style Selector="TextBlock.kicker">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="LetterSpacing" Value="5" />
    <Setter Property="Foreground" Value="{StaticResource SkyBrush}" />
  </Style>
  <Style Selector="TextBlock.body, SelectableTextBlock.body">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextAlignment" Value="Left" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="TextBlock.small, SelectableTextBlock.small">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextAlignment" Value="Left" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>
  <!-- The name of a setting on the Settings page. -->
  <Style Selector="TextBlock.rowtitle">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextAlignment" Value="Left" />
    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
  </Style>

  <!-- Focus: a bright outline the player can follow with the D-pad or Tab. -->
  <Style Selector="Button:focus-visible /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="White" />
    <Setter Property="BorderThickness" Value="3" />
  </Style>
  <!-- Radio buttons, tab headers and an Expander's header are not plain Buttons, so they get the same outline as an adorner. -->
  <Style Selector="RadioButton, TabItem, Expander, ToggleButton">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderBrush="White" BorderThickness="3" CornerRadius="3" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>

  <!-- The big button: Play, and Set up. -->
  <Style Selector="Button.play">
    <Setter Property="Background" Value="{StaticResource BallBrush}" />
    <Setter Property="Foreground" Value="{StaticResource Navy}" />
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FontSize" Value="44" />
    <Setter Property="Padding" Value="64,4,64,8" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="BorderBrush" Value="{StaticResource Navy}" />
    <Setter Property="BorderThickness" Value="3" />
  </Style>
  <Style Selector="Button.play:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BallHotBrush}" />
    <Setter Property="Foreground" Value="{StaticResource Navy}" />
  </Style>
  <Style Selector="Button.play:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="#4A4E2A" />
    <Setter Property="Foreground" Value="#2A2A2A" />
  </Style>

  <!-- Smaller actions. -->
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="#33203055" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderBrush" Value="#4A6BC4" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="22,9" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>
  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource CourtBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.secondary:disabled /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
</Styles>
