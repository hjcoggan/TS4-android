<!--
  The Launcher's look: bold condensed display type (Anton) and condensed body type (Barlow
  Condensed), both bundled under the SIL Open Font License; ball yellow and court blue on a dark
  base. This is the original look, and it holds no game art. When the player's art folder has
  the Top Spin 4 art, LauncherLook sets the colour of each brush below to the art palette
  (ThemePalette.Art in Launcher.Core) and the window shows the pictures; the brushes are
  changed in place, so every StaticResource below follows. Every button shows a thick focus
  outline, because the Launcher is driven by a pad as much as by a mouse.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <FontFamily x:Key="DisplayFont">avares://topspin4-launcher/Assets/Fonts#Anton</FontFamily>
    <FontFamily x:Key="BodyFont">avares://topspin4-launcher/Assets/Fonts#Barlow Condensed</FontFamily>

    <!-- Keys and values are ThemePalette.Original's (ThemePalette.Brushes); a test holds them equal and holds that palette to 4.5:1 text contrast. -->
    <SolidColorBrush x:Key="BaseBrush" Color="#0A1220" />
    <!-- Under text when a picture is behind the page; clear in the original look. -->
    <SolidColorBrush x:Key="ScrimBrush" Color="#00000000" />
    <SolidColorBrush x:Key="DimBrush" Color="#00000000" />
    <SolidColorBrush x:Key="PanelBrush" Color="#142038" />
    <SolidColorBrush x:Key="AccentBrush" Color="#D7E44A" />
    <SolidColorBrush x:Key="AccentHotBrush" Color="#EAF56E" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#D7E44A" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="#2A6FDB" />
    <SolidColorBrush x:Key="SilverBrush" Color="#8CB4FF" />
    <SolidColorBrush x:Key="TextBrush" Color="#E6ECFF" />
    <SolidColorBrush x:Key="MutedBrush" Color="#9AA8D0" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF8A7A" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#0A1220" />
    <SolidColorBrush x:Key="AccentDisabledBrush" Color="#4A4E2A" />
    <SolidColorBrush x:Key="OnAccentDisabledBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="SecondaryFillBrush" Color="#33203055" />
    <SolidColorBrush x:Key="SecondaryBorderBrush" Color="#4A6BC4" />
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <Style Selector="TextBlock.display">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <!-- Text sizes: the condensed face runs small, so even the smallest text is 18. Paragraphs are left-aligned. -->
  <Style Selector="TextBlock.kicker">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="LetterSpacing" Value="5" />
    <Setter Property="Foreground" Value="{StaticResource SilverBrush}" />
  </Style>
  <Style Selector="TextBlock.body, SelectableTextBlock.body">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextAlignment" Value="Left" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="TextBlock.small, SelectableTextBlock.small">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextAlignment" Value="Left" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>
  <!-- The name of a setting on the Settings page. -->
  <Style Selector="TextBlock.rowtitle">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextAlignment" Value="Left" />
    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
  </Style>

  <!-- Focus: a bright outline the player can follow with the D-pad or Tab. -->
  <!-- A button draws its own focus outline below, so it needs no focus adorner as well. -->
  <Style Selector="Button">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>
  <Style Selector="Button:focus-visible /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="White" />
    <Setter Property="BorderThickness" Value="3" />
  </Style>
  <!-- Radio buttons, tab headers and an Expander's header are not plain Buttons, so they get the same outline as an adorner. -->
  <Style Selector="RadioButton, TabItem, Expander, ToggleButton">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderBrush="White" BorderThickness="3" CornerRadius="3" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>

  <!-- The big button: Play, and Set up. -->
  <Style Selector="Button.play">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FontSize" Value="44" />
    <Setter Property="Padding" Value="64,4,64,8" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderBrush" Value="{StaticResource BaseBrush}" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.play:pressed">
    <Setter Property="RenderTransform" Value="scale(0.97)" />
  </Style>
  <Style Selector="Button.play:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentHotBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
  </Style>
  <Style Selector="Button.play:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentDisabledBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccentDisabledBrush}" />
  </Style>

  <!-- Smaller actions. -->
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{StaticResource SecondaryFillBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SecondaryBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="22,9" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>
  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SecondaryBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.secondary:disabled /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <!-- The tools beside PLAY: an icon over a short label. -->
  <!-- Opaque: a narrow window puts them over the clear part of the picture. -->
  <Style Selector="Button.tool">
    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SecondaryBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="MinWidth" Value="96" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SecondaryBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.tool:disabled /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <!-- The side rail's pages: an icon over a label; the open page is white with an accent bar. -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="4,0,0,0" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="0,10" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SecondaryFillBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.nav.current">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="Button.nav.current:pointerover /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>

  <!-- A card in the home screen's row, and a tile on the Achievements page. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="16,14" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <!-- A page fades in when it opens (MainWindow.ShowPage). -->
  <Style Selector="Panel#PageHost, Panel#FormHost">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
</Styles>
