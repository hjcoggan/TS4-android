<Project Sdk="Microsoft.NET.Sdk">
  <!-- Disc and TU1 preparation, with no UI types: the test seam. -->
  <PropertyGroup>
    <RootNamespace>TopSpin4.Launcher.Core</RootNamespace>
    <AssemblyName>TopSpin4.Launcher.Core</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <!-- The Disc art module reads its files through an internal seam (IDiscFileSource); a test puts a source that fails in ways a real disc rarely does behind it. -->
    <InternalsVisibleTo Include="Launcher.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Generated by scripts/write_manifests.py: paths, sizes and hashes, no game data. -->
    <EmbeddedResource Include="../../disc-manifest.tsv" LogicalName="disc-manifest.tsv" />
    <EmbeddedResource Include="../../tu1-manifest.tsv" LogicalName="tu1-manifest.tsv" />
    <!-- The XenosRecomp patch series the game is configured with (CMakeLists.txt hashes the same files). -->
    <XenosRecompPatch Include="../../../patches/xenosrecomp/*.patch" />
  </ItemGroup>

  <!--
    The converter id a shader pack must carry for this build's game, worked out as CMakeLists.txt and
    scripts/convert-shaders.ps1 do: the first 16 hex digits of the SHA-256 of the ASCII lower-case hex of every
    patch of patches/xenosrecomp, one after the other in name order.
  -->
  <UsingTask TaskName="XenosRecompSeriesId" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Patches ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Id Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Security.Cryptography" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var series = new StringBuilder();
        foreach (var path in Patches.Select(patch => patch.GetMetadata("FullPath")).OrderBy(path => Path.GetFileName(path), System.StringComparer.Ordinal))
            series.Append(System.BitConverter.ToString(File.ReadAllBytes(path)).Replace("-", "").ToLowerInvariant());
        byte[] hash;
        using (var sha = SHA256.Create()) hash = sha.ComputeHash(Encoding.ASCII.GetBytes(series.ToString()));
        Id = System.BitConverter.ToString(hash).Replace("-", "").Substring(0, 16).ToLowerInvariant();
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="ShaderConverterIdPath">
    <PropertyGroup>
      <!-- In obj/: IntermediateOutputPath is only known once the SDK's targets are imported. -->
      <ShaderConverterIdFile>$([System.IO.Path]::Combine($(MSBuildProjectDirectory), $(IntermediateOutputPath), 'ShaderConverterId.g.cs'))</ShaderConverterIdFile>
    </PropertyGroup>
  </Target>
  <Target Name="GenerateShaderConverterId" BeforeTargets="CoreCompile" DependsOnTargets="ShaderConverterIdPath">
    <XenosRecompSeriesId Patches="@(XenosRecompPatch)">
      <Output TaskParameter="Id" PropertyName="XenosRecompSeriesHash" />
    </XenosRecompSeriesId>
    <WriteLinesToFile File="$(ShaderConverterIdFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="// Generated from patches/xenosrecomp by Launcher.Core.csproj.;namespace TopSpin4.Launcher.Core%3B;public static partial class ShaderConverter { public const ulong Id = 0x$(XenosRecompSeriesHash)UL%3B }" />
  </Target>
  <Target Name="IncludeShaderConverterId" BeforeTargets="CoreCompile" AfterTargets="GenerateShaderConverterId" DependsOnTargets="ShaderConverterIdPath">
    <ItemGroup>
      <Compile Include="$(ShaderConverterIdFile)" />
      <FileWrites Include="$(ShaderConverterIdFile)" />
    </ItemGroup>
  </Target>
</Project>
