From 11a0bc462191037b5e5f50c22737e7db9a92202a Mon Sep 17 00:00:00 2001
From: hjcoggan <191880570+hjcoggan@users.noreply.github.com>
Date: Sun, 22 Nov 2026 05:54:26 +1000
Subject: [PATCH] filesystem: fall back to flat files for locale paths

Top Spin 4's XUI loader asks for its packages under a locale folder
(Media\XUI\eng\Startup.xzp), but the disc ships them flat
(Media\XUI\Startup.xzp). ResolvePath's lazy host walk failed at the
missing eng component, the open returned no-such-file, and the loader
retried the same package once a second forever on its loading screen
(the Nova's 'stuck loading' TS4).

When the walk misses, and only then, retry once with a locale-named
component (eng/fre/ger/ita/spa/jpn/kor/cht/chs) dropped, mirroring the
game's own Locale fallback. Verified against the flat disc layout in
codegen/manifests/disc-manifest.tsv; the device no longer needs
hand-made eng/ symlinks in gamedata.
---
 src/filesystem/devices/host_path_device.cpp | 111 ++++++++++++++------
 1 file changed, 76 insertions(+), 35 deletions(-)

diff --git a/src/filesystem/devices/host_path_device.cpp b/src/filesystem/devices/host_path_device.cpp
index f68b79a..f59f1b5 100644
--- a/src/filesystem/devices/host_path_device.cpp
+++ b/src/filesystem/devices/host_path_device.cpp
@@ -67,50 +67,91 @@ Entry* HostPathDevice::ResolvePath(const std::string_view path) {
 
   // Fallback to a lazy case-insensitive host lookup when an entry is missing
   // from the in-memory tree (for example because casing differs on Linux).
-  auto* current_entry = static_cast<HostPathEntry*>(root_entry_.get());
-  for (const auto& part : rex::string::utf8_split_path(path)) {
-    if (part.empty()) {
-      continue;
-    }
-
-    auto* child = current_entry->GetChild(part);
-    if (!child) {
-      // Stat the exact name first: enumerating a directory of hundreds of
-      // archives costs milliseconds a walk. Only casing mismatch reaches
-      // the scan below.
-      const auto exact_path = current_entry->host_path() / rex::to_path(part);
-      rex::filesystem::FileInfo exact_info;
-      if (rex::filesystem::GetInfo(exact_path, &exact_info)) {
-        auto* exact_child = HostPathEntry::Create(this, current_entry, exact_path, exact_info);
-        if (!exact_child) {
-          return nullptr;
-        }
-        current_entry->children_.push_back(std::unique_ptr<Entry>(exact_child));
-        current_entry = static_cast<HostPathEntry*>(exact_child);
+  const auto parts = rex::string::utf8_split_path(path);
+  const auto lazy_walk = [&](const std::vector<std::string_view>& walk_parts) -> Entry* {
+    auto* current_entry = static_cast<HostPathEntry*>(root_entry_.get());
+    for (const auto& part : walk_parts) {
+      if (part.empty()) {
         continue;
       }
 
-      auto child_infos = rex::filesystem::ListFiles(current_entry->host_path());
-      auto match = std::find_if(child_infos.begin(), child_infos.end(), [&](const auto& info) {
-        return rex::string::utf8_equal_case(rex::path_to_utf8(info.name), part);
-      });
-      if (match == child_infos.end()) {
-        return nullptr;
+      auto* child = current_entry->GetChild(part);
+      if (!child) {
+        // Stat the exact name first: enumerating a directory of hundreds of
+        // archives costs milliseconds a walk. Only casing mismatch reaches
+        // the scan below.
+        const auto exact_path = current_entry->host_path() / rex::to_path(part);
+        rex::filesystem::FileInfo exact_info;
+        if (rex::filesystem::GetInfo(exact_path, &exact_info)) {
+          auto* exact_child = HostPathEntry::Create(this, current_entry, exact_path, exact_info);
+          if (!exact_child) {
+            return nullptr;
+          }
+          current_entry->children_.push_back(std::unique_ptr<Entry>(exact_child));
+          current_entry = static_cast<HostPathEntry*>(exact_child);
+          continue;
+        }
+
+        auto child_infos = rex::filesystem::ListFiles(current_entry->host_path());
+        auto match = std::find_if(child_infos.begin(), child_infos.end(), [&](const auto& info) {
+          return rex::string::utf8_equal_case(rex::path_to_utf8(info.name), part);
+        });
+        if (match == child_infos.end()) {
+          return nullptr;
+        }
+
+        auto new_child = HostPathEntry::Create(this, current_entry,
+                                               current_entry->host_path() / match->name, *match);
+        if (!new_child) {
+          return nullptr;
+        }
+        child = new_child;
+        current_entry->children_.push_back(std::unique_ptr<Entry>(new_child));
       }
 
-      auto new_child = HostPathEntry::Create(this, current_entry,
-                                             current_entry->host_path() / match->name, *match);
-      if (!new_child) {
-        return nullptr;
-      }
-      child = new_child;
-      current_entry->children_.push_back(std::unique_ptr<Entry>(new_child));
+      current_entry = static_cast<HostPathEntry*>(child);
     }
 
-    current_entry = static_cast<HostPathEntry*>(child);
+    return current_entry;
+  };
+
+  if (auto* resolved_entry = lazy_walk(parts)) {
+    return resolved_entry;
   }
 
-  return current_entry;
+  // Top Spin 4's XUI loader asks for its packages under a locale folder
+  // (Media\XUI\eng\Startup.xzp), but the disc ships them flat
+  // (Media\XUI\Startup.xzp): with no eng directory the open fails and the
+  // loader retries the same package forever on its loading screen. Mirror
+  // the game's own locale fallback: when the walk missed, and only then,
+  // retry once with a locale-named component dropped.
+  static constexpr std::string_view kLocaleComponents[] = {
+      "eng", "fre", "ger", "ita", "spa", "jpn", "kor", "cht", "chs",
+  };
+  for (size_t locale_at = 0; locale_at < parts.size(); ++locale_at) {
+    const bool is_locale = std::any_of(
+        std::begin(kLocaleComponents), std::end(kLocaleComponents),
+        [&](const std::string_view locale) {
+          return rex::string::utf8_equal_case(parts[locale_at], locale);
+        });
+    if (!is_locale) {
+      continue;
+    }
+    std::vector<std::string_view> without_locale;
+    without_locale.reserve(parts.size() - 1);
+    for (size_t i = 0; i < parts.size(); ++i) {
+      if (i != locale_at) {
+        without_locale.push_back(parts[i]);
+      }
+    }
+    if (auto* resolved_entry = lazy_walk(without_locale)) {
+      REXFS_WARN("ResolvePath: {} not found; resolved via locale fallback", path);
+      return resolved_entry;
+    }
+    break;
+  }
+
+  return nullptr;
 }
 
 void HostPathDevice::PopulateEntry(HostPathEntry* parent_entry) {
