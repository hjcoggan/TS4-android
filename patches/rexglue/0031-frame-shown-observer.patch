diff --git a/src/kernel/xboxkrnl/xboxkrnl_video.cpp b/src/kernel/xboxkrnl/xboxkrnl_video.cpp
index de53e58..d307229 100644
--- a/src/kernel/xboxkrnl/xboxkrnl_video.cpp
+++ b/src/kernel/xboxkrnl/xboxkrnl_video.cpp
@@ -92,6 +92,22 @@ std::atomic<uint64_t> guest_swaps{0};
 }  // namespace
 
 uint64_t GuestSwapCount() { return guest_swaps.load(std::memory_order_relaxed); }
+
+namespace {
+std::atomic<FrameShownObserver> frame_shown_observer{nullptr};
+uint64_t frames_shown = 0;  // GPU thread only
+}  // namespace
+
+void SetFrameShownObserver(FrameShownObserver observer) {
+  frame_shown_observer.store(observer, std::memory_order_release);
+}
+
+void NotifyFrameShown() {
+  const uint64_t frame = frames_shown++;
+  if (FrameShownObserver observer = frame_shown_observer.load(std::memory_order_acquire)) {
+    observer(frame);
+  }
+}
 }  // namespace rex::system
 
 namespace rex::kernel::xboxkrnl {
