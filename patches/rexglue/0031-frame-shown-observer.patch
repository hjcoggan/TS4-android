diff --git a/include/rex/system/guest_swaps.h b/include/rex/system/guest_swaps.h
index 00521e0..efad7b4 100644
--- a/include/rex/system/guest_swaps.h
+++ b/include/rex/system/guest_swaps.h
@@ -13,4 +13,13 @@ namespace rex::system {
 // it. Hosts time scripted input and frame captures by it.
 uint64_t GuestSwapCount();
 
+// Called on the GPU thread once each swap's image is the presenter's newest guest output, with
+// the swaps the GPU had shown before it: the same clock as GuestSwapCount, so frame N here is
+// the one the guest presented after GuestSwapCount reached N. Hosts dump frames from it. One
+// observer; nullptr removes it.
+using FrameShownObserver = void (*)(uint64_t frame);
+void SetFrameShownObserver(FrameShownObserver observer);
+// The GPU's side: call after each swap.
+void NotifyFrameShown();
+
 }  // namespace rex::system
