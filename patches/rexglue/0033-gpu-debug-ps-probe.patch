+bool SpirvShaderTranslator::IsDebugProbedPixelShader() const {
+  const std::string& hash_text = REXCVAR_GET(gpu_debug_ps_hash);
+  if (!is_pixel_shader() || hash_text.empty() || REXCVAR_GET(gpu_debug_ps_register) < 0 ||
+      uint32_t(REXCVAR_GET(gpu_debug_ps_register)) >= register_count()) {
+    return false;
+  }
+  uint64_t hash = 0;
+  const auto [end, error] =
+      std::from_chars(hash_text.data(), hash_text.data() + hash_text.size(), hash, 16);
+  return error == std::errc() && end == hash_text.data() + hash_text.size() &&
+         hash == current_shader().ucode_data_hash();
+}
+
+void SpirvShaderTranslator::ProcessInstructionEnd(uint32_t ucode_address) {
+  if (debug_probe_capture_ == spv::NoResult ||
+      int32_t(ucode_address) != REXCVAR_GET(gpu_debug_ps_after)) {
+    return;
+  }
+  id_vector_temp_util_.clear();
+  id_vector_temp_util_.push_back(builder_->makeIntConstant(REXCVAR_GET(gpu_debug_ps_register)));
+  builder_->createStore(
+      builder_->createLoad(builder_->createAccessChain(spv::StorageClassFunction,
+                                                       var_main_registers_, id_vector_temp_util_),
+                           spv::NoPrecision),
+      debug_probe_capture_);
+}
+
+void SpirvShaderTranslator::StoreDebugProbeColor() {
+  if (!debug_probe_ || !(current_shader().writes_color_targets() & 1)) {
+    return;
+  }
+  spv::Id value;
+  if (debug_probe_capture_ != spv::NoResult) {
+    value = builder_->createLoad(debug_probe_capture_, spv::NoPrecision);
+  } else {
+    id_vector_temp_util_.clear();
+    id_vector_temp_util_.push_back(builder_->makeIntConstant(REXCVAR_GET(gpu_debug_ps_register)));
+    value = builder_->createLoad(builder_->createAccessChain(spv::StorageClassFunction,
+                                                             var_main_registers_,
+                                                             id_vector_temp_util_),
+                                 spv::NoPrecision);
+  }
+  spv::Id channels[4] = {const_float_0_, const_float_0_, const_float_0_, const_float_1_};
+  const std::string& components = REXCVAR_GET(gpu_debug_ps_components);
+  for (size_t i = 0; i < 3 && i < components.size(); ++i) {
+    size_t component = std::string_view("xyzw").find(components[i]);
+    if (component == std::string_view::npos) {
+      continue;
+    }
+    channels[i] = builder_->createTriBuiltinCall(
+        type_float_, ext_inst_glsl_std_450_, GLSLstd450NClamp,
+        builder_->createCompositeExtract(value, type_float_, uint32_t(component)), const_float_0_,
+        const_float_1_);
+  }
+  id_vector_temp_util_.assign(channels, channels + 4);
+  builder_->createStore(builder_->createCompositeConstruct(type_float4_, id_vector_temp_util_),
+                        output_or_var_fragment_data_[0]);
+}
+
 }  // namespace rex::graphics
