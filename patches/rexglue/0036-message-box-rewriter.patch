+/**
+ * @file        kernel/xam/message_box.h
+ * @brief       Host hook on the title's XamShowMessageBoxUI dialogs
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <functional>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace rex::kernel::xam {
+
+// A message box as the title asked for it, before it shows.
+struct TitleMessageBox {
+  std::string title;
+  std::string text;
+  std::vector<std::string> buttons;
+  uint32_t active_button = 0;
+};
+
+// Called for each XamShowMessageBoxUI before the dialog shows (or before headless answers it).
+// It may change the box; when it returns an answer, the title gets that button index whatever
+// the player picks, else the player's choice. One rewriter; nullptr removes it.
+using MessageBoxRewriter = std::function<std::optional<uint32_t>(TitleMessageBox& box)>;
+void SetMessageBoxRewriter(MessageBoxRewriter rewriter);
+
+}  // namespace rex::kernel::xam
