+constexpr uint32_t kXNotificationSystemUI = 0x00000009;  // XN_SYS_UI
+
 u32 XamShowSigninUI_entry(u32 unk, u32 unk_mask) {
   // Mask values vary. Probably matching user types? Local/remote?
 
+  if (REXCVAR_GET(signin_ui_closes_unchanged)) {
+    // The player closed the picker: the system UI opens and closes, and no sign-in changed.
+    // As on the console the call returns first: titles create their XN_SYS_UI listener after
+    // it and wait for 1, then 0 (Top Spin 4's Swing 0x888C1570). So the kernel's dispatch
+    // thread waits for that listener (up to 2 s), then broadcasts; it also keeps two calls'
+    // broadcasts from interleaving.
+    REXKRNL_INFO("XamShowSigninUI({:08X}, {:08X}): closed with no sign-in change", uint32_t(unk),
+                 uint32_t(unk_mask));
+    KernelState* kernel = REX_KERNEL_STATE();
+    const uint64_t listeners = kernel->notify_listeners_created();
+    kernel->Dispatch([kernel, listeners] {
+      for (int waited = 0; waited < 2000 && kernel->dispatch_running() &&
+                           kernel->notify_listeners_created() == listeners;
+           waited += 5) {
+        rex::thread::Sleep(std::chrono::milliseconds(5));
+      }
+      if (!kernel->dispatch_running()) return;
+      kernel->BroadcastNotification(kXNotificationSystemUI, 1);
+      rex::thread::Sleep(std::chrono::milliseconds(100));
+      kernel->BroadcastNotification(kXNotificationSystemUI, 0);
+    });
+    return X_ERROR_SUCCESS;
+  }
+
   // To fix game modes that display a 4 profile signin UI (even if playing
   // alone):
   // XN_SYS_SIGNINCHANGED
