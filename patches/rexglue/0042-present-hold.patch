+/**
+ * @file        ui/present_hold.h
+ * @brief       How long after the guest vblank to hold a finished frame before presenting it
+ *
+ * On a variable-refresh display (or the host clock) the display shows a frame when the present
+ * reaches it, and a present queued before the frame's GPU work is done reaches it when that work
+ * completes. Frames finishing a few milliseconds apart after the guest vblank were then shown a
+ * few milliseconds apart from the 60 Hz step: 8-14 % of display changes at 4x Resolution scale
+ * with 8x MSAA on a 360 Hz VRR display. The presenter instead waits for each frame's GPU work,
+ * then presents at a hold point after the guest vblank, the same for every frame: the 95th
+ * percentile of recent completion times plus a margin, between the paced present offset and the
+ * period less a millisecond. A frame finishing later still is presented as soon as it is done.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+namespace rex::ui::pacing {
+
+class PresentHold {
+ public:
+  // About 4 s of frames at 60 Hz, so the hold follows a scene getting lighter or heavier.
+  static constexpr size_t kWindow = 240;
+  static constexpr int64_t kMarginUs = 1000;
+  static constexpr int64_t kEndMarginUs = 1000;
+
+  // A frame's GPU work completed this long after its guest vblank.
+  void Completed(int64_t after_vblank_us) {
+    window_[next_] = after_vblank_us;
+    next_ = (next_ + 1) % kWindow;
+    count_ = std::min(count_ + 1, kWindow);
+  }
+
+  // The hold point after the guest vblank, in microseconds.
+  int64_t HoldUs(int64_t offset_us, int64_t period_us) const {
+    const int64_t latest = std::max(offset_us, period_us - kEndMarginUs);
+    if (count_ == 0) return std::min(offset_us, latest);
+    std::array<int64_t, kWindow> sorted;
+    std::copy_n(window_.begin(), count_, sorted.begin());
+    const size_t p95 = (count_ * 95) / 100;
+    std::nth_element(sorted.begin(), sorted.begin() + p95, sorted.begin() + count_);
+    return std::clamp(sorted[p95] + kMarginUs, offset_us, latest);
+  }
+
+ private:
+  std::array<int64_t, kWindow> window_{};
+  size_t next_ = 0;
+  size_t count_ = 0;
+};
+
+}  // namespace rex::ui::pacing
