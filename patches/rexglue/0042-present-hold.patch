+bool Presenter::HeldPresent(std::chrono::steady_clock::time_point& until) const {
+  std::lock_guard lock(present_hold_mutex_);
+  until = present_hold_until_;
+  return until != std::chrono::steady_clock::time_point{};
+}
+
+void Presenter::PresentHoldCompleted(std::chrono::steady_clock::time_point done) {
+  std::lock_guard lock(present_hold_mutex_);
+  if (present_hold_until_ == std::chrono::steady_clock::time_point{}) {
+    return;
+  }
+  present_hold_.Completed(
+      std::chrono::duration_cast<std::chrono::microseconds>(done - present_hold_vblank_).count());
+}
