diff --git a/XenosRecomp/shader_common.h b/XenosRecomp/shader_common.h
index 8bce2e0..d1a0407 100644
--- a/XenosRecomp/shader_common.h
+++ b/XenosRecomp/shader_common.h
@@ -10,6 +10,9 @@
     // with an sRGB view: write sRGB-decode(PWL-encode(colour)) so the stored
     // byte is the Xbox 360's piecewise-linear (PWL) byte.
     #define SPEC_CONSTANT_PWL_GAMMA_OUTPUT (1 << 3)
+    // Normals in Xenos k_2_10_10_10, signed and normalized (D3DDECLTYPE 0x2A2187, DEC3N):
+    // X, Y and Z in 10 bits each from the low bits, W in the top 2 (Top Spin 4).
+    #define SPEC_CONSTANT_DEC3N_NORMAL (1 << 4)
 #endif
 
 #ifdef UNLEASHED_RECOMP
@@ -368,6 +371,12 @@ float4 tfetchR11G11B10(uint4 value)
         float3 n = float3((v << 22) >> 22, (v << 11) >> 21, v >> 21) / float3(511.0, 1023.0, 1023.0);
         return float4(max(n, -1.0), 0.0);
     }
+    if (g_SpecConstants() & SPEC_CONSTANT_DEC3N_NORMAL)
+    {
+        int v = int(value.x);
+        float3 n = float3((v << 22) >> 22, (v << 12) >> 22, (v << 2) >> 22) / 511.0;
+        return float4(max(n, -1.0), float(v >> 30));
+    }
     if (g_SpecConstants() & SPEC_CONSTANT_BYTE_NORMAL)
     {
         return float4(value);
