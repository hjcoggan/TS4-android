diff --git a/XenosRecomp/shader_common.h b/XenosRecomp/shader_common.h
index d1a0407..7f6701b 100644
--- a/XenosRecomp/shader_common.h
+++ b/XenosRecomp/shader_common.h
@@ -397,6 +397,13 @@ float4 tfetchPosition(uint swapped, float4 value, uint semanticIndex)
     if (swapped & (1u << (24 + semanticIndex))) value.zw = value.wz;
     return value;
 }
+
+// 16-bit blend weights: bit 8+i swaps each half pair (.yxwz), as texcoords do (Top Spin 4's
+// USHORT4N skin weights).
+float4 tfetchBlendWeight(uint swapped, float4 value, uint semanticIndex)
+{
+    return (swapped & (1u << (8 + semanticIndex))) != 0 ? value.yxwz : value;
+}
 #else
 float4 tfetchR11G11B10(uint4 value)
 {
