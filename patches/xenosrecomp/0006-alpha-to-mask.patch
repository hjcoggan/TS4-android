@@ -2586,6 +2592,20 @@ void ShaderRecompiler::recompile(const uint8_t* shaderData, const std::string_vi
                     out += "}";
 
                 #ifdef SVR2011_RECOMP
+                    // Alpha to mask (RB_COLORCONTROL bit 4) after the alpha test, with the
+                    // emulated path's per-sample thresholds and 2x2 dither offsets
+                    // (spirv_translator_rb.cpp), not the host's alpha to coverage.
+                    if (hasCoverageOutput)
+                    {
+                        specConstantsMask |= SPEC_CONSTANT_ALPHA_TO_MASK;
+                        indent();
+                        out += "oMask = 0xFFFFFFFF;\n";
+                        indent();
+                        out += "[branch] if (g_SpecConstants() & SPEC_CONSTANT_ALPHA_TO_MASK)";
+                        indent();
+                        out += "\toMask = alphaToMask(oC0.w, uint2(iPos.xy));\n";
